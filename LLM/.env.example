# Example environment variables for the LLM module
# Copy this file to LLM/.env and fill in your own values.

# Google Gemini API key (Required)
GEMINI_API_KEY=

# Hugging Face API key (Required for models/inference)
HUGGINGFACE_API_KEY=

# Optional: AI APIs (for models requiring specialized inference)
FAL_AI_API_KEY=
REPLICATE_API_TOKEN=

# Supabase configuration (Required for RAG/telemetry)
SUPABASE_URL=https://your-supabase-instance-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
