# Copiaza acest fisier in `.env` si completeaza valorile reale.
# Variabilele EXPO_PUBLIC_* sunt citite la PORNIREA serverului Expo (restart necesar).

# Backend principal (API: anunturi, facultati, locatii, auth, ...)
EXPO_PUBLIC_API_BASE_URL=http://<ip-server>:8002

# Serviciul LLM (optional — chat-ul ACE merge prin gateway-ul de pe API_BASE_URL)
EXPO_PUBLIC_LLM_BASE_URL=http://<ip-server>:8000

# Stilul hartii MapTiler
EXPO_PUBLIC_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/<id>/style.json?key=<key>

# Dashboard-ul de administrare
EXPO_PUBLIC_DASHBOARD_URL=https://dashboard.insideugal.ro
