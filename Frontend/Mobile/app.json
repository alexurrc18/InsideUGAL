{
  "expo": {
    "name": "InsideUGAL",
    "slug": "InsideUGAL",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.InsideUGAL.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aplicația are nevoie de locație pentru a afișa poziția ta pe hartă.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aplicația are nevoie de locație pentru a afișa poziția ta pe hartă."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00479E",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.InsideUGAL.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "ios": {
            "nativeVersion": "6.26.0"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplicația folosește locația pentru a afișa poziția ta pe harta campusului."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
