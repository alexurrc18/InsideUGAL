* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.tar binary
*.db binary

# Treat lockfiles as generated during merge
package-lock.json merge=ours
yarn.lock merge=ours

# Normalize line endings for text files
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.md text
*.py text
*.yml text
*.yaml text
*.toml text
*.html text
*.css text
*.scss text

# Keep Git metadata files as text
.gitattributes text
.editorconfig text
