root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yaml,yml,html,css,scss,ts,tsx,js,jsx}]
indent_size = 2

[*.{sh,Makefile}]
indent_style = space
indent_size = 2
