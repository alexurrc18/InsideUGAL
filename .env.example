# Copiaza in .env si completeaza valorile reale.
# Nu commita fisierul .env in git.

# ─── Postgres / Supabase DB ───────────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=54399

# ─── Backend (FastAPI) ────────────────────────────────────────────────────────
# Connection string catre baza de date (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@supabase-db:5432/postgres

ENVIRONMENT=development
# Hosturi permise (separate prin virgula)
ALLOWED_HOSTS=localhost,127.0.0.1,*.local

# Origini permise pentru CORS (separate prin virgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Adresa interna a serviciului LLM (in Docker: http://llm:8000)
LLM_SERVICE_URL=http://llm:8000

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_AUTH_URL=http://supabase-kong:8000/auth/v1
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alias folosit de modulul LLM (identic cu SERVICE_ROLE_KEY)
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# Audience JWT Supabase (default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated

STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_TENANT_ID=insideugal
STORAGE_REGION=local
STORAGE_BUCKET_PATH=storage

# ─── Frontend Dashboard (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── LLM / AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Secret pentru endpoint-ul /api/v1/admin/rebuild-rag
ADMIN_SECRET=
# Secret pentru webhook-ul Supabase
SUPABASE_WEBHOOK_SECRET=
# URL-ul backend-ului accesat din containerul LLM
BACKEND_URL=http://backend:8000

# ─── Mobile (Expo) ────────────────────────────────────────────────────────────
# Variabilele EXPO_PUBLIC_* sunt citite la pornirea serverului Expo (restart necesar)
EXPO_PUBLIC_API_BASE_URL=http://<ip-server>:8002
EXPO_PUBLIC_LLM_BASE_URL=http://<ip-server>:8001
EXPO_PUBLIC_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/<id>/style.json?key=<key>
EXPO_PUBLIC_DASHBOARD_URL=https://dashboard.insideugal.ro